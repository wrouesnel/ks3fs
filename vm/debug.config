# Debug options layered on the Ubuntu config for the sanitizer test kernel.
# (DEBUG_OBJECTS is omitted: Noble 6.8 lib/debugobjects.c uses __data_racy,
# which that tree never defines, so it does not compile.)
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=n
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_DEBUG_INFO_NONE=y
# trim the build
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_INFINIBAND=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_TLS=y
