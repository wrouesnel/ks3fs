# xfstests that cannot pass on ks3fs because of documented limitations.
# Everything else in the quick group must pass or be skipped (_notrun).

# no special files (mknod is EPERM)
generic/696	# vfstest setgid-create-umask: mknodat

# S3 caps user metadata at 2 KiB per object, so only a few xattrs fit
generic/020	# hundreds of attributes per file
